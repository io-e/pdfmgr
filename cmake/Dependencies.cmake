# MuPDF and QPDF. On Debian: system packages via pkg-config / plain libs.
# On Windows (vcpkg): vcpkg provides unofficial-mupdf / qpdf CMake configs.
find_package(qpdf CONFIG QUIET)
if(TARGET qpdf::libqpdf)
  add_library(pdfmgr_qpdf INTERFACE)
  target_link_libraries(pdfmgr_qpdf INTERFACE qpdf::libqpdf)
else()
  find_package(PkgConfig REQUIRED)
  pkg_check_modules(QPDF REQUIRED IMPORTED_TARGET libqpdf)
  add_library(pdfmgr_qpdf INTERFACE)
  target_link_libraries(pdfmgr_qpdf INTERFACE PkgConfig::QPDF)
endif()

find_package(unofficial-mupdf CONFIG QUIET)
if(TARGET unofficial::mupdf::mupdf)
  add_library(pdfmgr_mupdf INTERFACE)
  target_link_libraries(pdfmgr_mupdf INTERFACE unofficial::mupdf::mupdf)
else()
  find_path(MUPDF_INCLUDE_DIR mupdf/fitz.h REQUIRED)
  find_library(MUPDF_LIBRARY mupdf REQUIRED)
  add_library(pdfmgr_mupdf INTERFACE)
  target_include_directories(pdfmgr_mupdf INTERFACE ${MUPDF_INCLUDE_DIR})
  target_link_libraries(pdfmgr_mupdf INTERFACE ${MUPDF_LIBRARY})
  # Static MuPDF builds need its third-party libs too:
  if(MUPDF_LIBRARY MATCHES "\\.a$")
    foreach(l mupdf-third jbig2dec openjp2 jpeg harfbuzz freetype gumbo mujs z m)
      find_library(_l_${l} ${l})
      if(_l_${l})
        target_link_libraries(pdfmgr_mupdf INTERFACE ${_l_${l}})
      endif()
    endforeach()
  endif()
endif()
